# .gitignore示例
node_modules/
.env
.DS_Store
*.log
dist/
build/
.idea/
.vscode/






















# 依赖文件夹
node_modules/
.pnp/
.pnp.js

# 构建产物
dist/
build/
output/
.next/
.nuxt/
.vuepress/dist/

# 环境变量文件
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 日志文件
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# 编辑器和IDE配置
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# 包管理器缓存
.npm
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# 测试覆盖报告
coverage/
*.lcov
.nyc_output

# 临时文件
*.tmp
*.temp
.cache/

